# Public client key from the selected Clerk application's API keys page.
# Copy this file to .env only if you do not already have one.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Public deployment URL from the Convex development dashboard.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Configure CLERK_SECRET_KEY, CLERK_JWT_ISSUER_DOMAIN, and
# CLERK_AUTHORIZED_PARTIES on the Convex deployment (server-only).
# See docs/dashboards.md. No PostgreSQL DATABASE_URL is needed.
